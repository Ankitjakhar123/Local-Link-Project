{
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/Frontend/index.html"
    }
  ],
  "routes": [
    {
      "src": "/[^.]+",
      "dest": "/Frontend",
      "status": 200
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "s-maxage=0" }
      ]
    },
    {
      "source": "/(.*).(jpe?g|png|webp|avif|svg|ico)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "outputDirectory": "Frontend"
} 